# ==============================================================================
# CLIQ — Environment Configuration Template
# Copy this file to ".env" and customize with your local/deployment values:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# NOTE: ".env" is strictly ignored by Git. Never commit real credentials.
# ==============================================================================

# ── Server & Application Hosting ─────────────────────────────────────────────
# Host interface and port binding for FastAPI and static asset serving
CLIQ_HOST=0.0.0.0
CLIQ_PORT=8000

# Path to the compiled React/xterm.js frontend bundle
# In Docker, this is pre-configured to /app/frontend/dist
CLIQ_FRONTEND_DIR=frontend/dist

# Path to persistent session log SQLite database
# In Docker, this defaults to /app/.cliq/session_log.sqlite (persisted via cliq_data volume)
CLIQ_SESSION_DB=

# ── NetSim Reservation Policy (Optional) ─────────────────────────────────────
# warn     = allow unverifiable logins with an in-session warning banner (default)
# enforce  = reject unverifiable logins (recommended for shared deployments)
# disabled = bypass reservation validation entirely (local troubleshooting only)
CLIQ_RESERVATION_POLICY=warn

# Personal NetSim API key for lab reservation verification (if required)
CLIQ_NETSIM_API_KEY=

# ── Cisco Modeling Labs (CML) Configuration (Optional) ──────────────────────
# Default CML host or gateway. Can also be entered dynamically in the web UI.
# In Docker Desktop, use "host.docker.internal" if CML is hosted locally.
# Example: 10.10.x.x or cml.example.com
CML_HOST=

# CML REST API port (default: 443)
CML_PORT=443

# SSL certificate verification for CML HTTPS endpoint (true/false)
CML_VERIFY_SSL=false

# ── Logging & Diagnostics ───────────────────────────────────────────────────
# Maximum trace buffer size in bytes for diagnostic bundle export (default: 5MB)
CLIQ_TRACE_BYTES=5242880

# Log rotation maximum file size in bytes (default: 10MB)
CLIQ_LOG_MAX_BYTES=10485760

# Number of rotated log backups to retain (default: 5)
CLIQ_LOG_MAX_BACKUPS=5

# ── Air-Gapped / Offline Flags ───────────────────────────────────────────────
# Enforce strict offline operation for embedded tokenizers / vector models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
