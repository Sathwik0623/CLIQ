# CLIQ local environment — copy this file to ".env" and fill in YOUR values.
#   PowerShell:  Copy-Item .env.example .env
# ".env" is git-ignored (see .gitignore) and is personal to your machine.
# A variable already exported in your shell ($env:...) overrides the file.

# ── NetSim reservation verification (per-developer secret) ──────────────────
# Your personal NetSim API key. It ROTATES EVERY 30 DAYS — regenerate it on the
# NetSim portal (API KeyGen) when the backend logs "DEGRADED" at startup.
# Each person has their OWN key; never share or commit it.
CLIQ_NETSIM_API_KEY=


# ── Reservation policy (optional) ───────────────────────────────────────────
# warn    = allow unverifiable logins with a visible banner (dev default)
# enforce = refuse unverifiable logins (recommended for hosted/shared use)
# disabled = bypass NetSim reservation verification and suppress reservation
#            warning banners entirely (local troubleshooting only)
# CLIQ_RESERVATION_POLICY=warn
